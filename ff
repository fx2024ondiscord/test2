F.connect(Run.Heartbeat, function(dt)
    if not S.alive then return end

    local now = os.clock()
    F.character()

    local gui = player:FindFirstChild("PlayerGui")

    if gui and (not S.ui or S.ui.Parent ~= gui) then
        F.mountUI()
    end

    if S.ui then S.ui.Enabled = true end

    F.blocked()

    if now >= S.nextBalls then
        F.syncBalls()
        S.nextBalls = now + 0.12
    end

    if now >= S.nextWorld then
        F.world()
        S.nextWorld = now + (C.Moss and 0.25 or 0.5)
    end

    if now >= S.nextEnemies then
        F.enemies(now)
        S.nextEnemies = now + 0.08
    end

    if now >= S.nextPing then
        F.latency()
        S.nextPing = now + 0.5
    end

    F.observe(now)

    local reserved = F.moss(now)
    S.mossMessage = C.Moss and S.message or nil

    if not reserved and now >= S.nextControl then
        local elapsed = S.lastControl
            and now - S.lastControl or dt

        F.control(now, math.clamp(elapsed, 0.002, 0.12))
        S.lastControl = now
        S.nextControl = now + 0.03
    end

    if now >= S.nextHud then
        S.sphere.Adornee = S.root
        S.sphere.Radius = C.MossRange
        S.sphere.Visible = C.Ring and S.root ~= nil

        S.sphere.Color3 = C.Moss
            and Color3.fromRGB(70, 245, 150)
            or Color3.fromRGB(255, 166, 80)

        S.sphere.Transparency = C.Moss and 0.90 or 0.96

        F.updateRing()

        S.outline.Adornee =
            S.inspectedPart
            and S.inspectedPart.Parent
            and S.inspectedPart
            or nil

        S.preview.Adornee = S.ball
        S.preview.Radius = C.ReachSize * 0.5
        S.preview.Visible = C.Preview and S.ball ~= nil

        F.hud()
        S.nextHud = now + 0.15
    end
end)

