local fileName = "AXION_Classic_Config.json"

pcall(function()
    local data = env.AXION_ADVANCED_OPTIONS

    if type(isfile) == "function"
        and type(readfile) == "function"
        and isfile(fileName) then
        data = Http:JSONDecode(readfile(fileName))
    end

    if type(data) ~= "table"
        and type(isfile) == "function"
        and type(readfile) == "function"
        and isfile("AXION_SmartTouch_V3_Config.json") then

        local old = Http:JSONDecode(
            readfile("AXION_SmartTouch_V3_Config.json")
        )

        data = {}

        local names = {
            Walk = "AutoWalk",
            Avoid = "AvoidPlayers",
            Shield = "SafeReach",
            MossHeight = "MossShotHeight",
            Air = "AirAssist",
            Trick = "TrickMode",
            Style = "MossStyle",
            Ring = "MossRing",
        }

        for _, key in ipairs(configKeys) do
            data[key] = old[names[key] or key]
        end
    end

    if type(data) ~= "table" then return end

    if type(data.DribbleKey) == "string" then
        local reserved = {
            H = true, K = true, B = true, U = true, N = true,
            Five = true, Nine = true, Eight = true,
            Unknown = true, Escape = true,
            W = true, A = true, S = true, D = true,
            Up = true, Down = true, Left = true, Right = true,
            Space = true, KeypadFive = true,
            KeypadNine = true, KeypadEight = true,
            Minus = true, Equals = true,
            KeypadMinus = true, KeypadPlus = true,
        }

        local ok, key = pcall(function()
            return Enum.KeyCode[data.DribbleKey]
        end)

        if ok and key and not reserved[data.DribbleKey] then
            C.DribbleKey = key
        end
    end

    for _, key in ipairs(configKeys) do
        local value = data[key]

        if type(value) == type(C[key])
            and (
                type(value) ~= "number"
                or (value == value and math.abs(value) < math.huge)
            ) then
            C[key] = value
        end
    end
end)

C.ReachSize = math.clamp(C.ReachSize, 1, 10)
C.MossRange = math.clamp(C.MossRange, 2, 18)
C.MossHeight = math.clamp(C.MossHeight, 0, 7.5)
C.Walk = false

if C.Style ~= "LOW"
    and C.Style ~= "SMART"
    and C.Style ~= "HIGH"
    and C.Style ~= "CUSTOM" then
    C.Style = "LOW"
end

if C.Trick ~= "SMART"
    and C.Trick ~= "ALWAYS"
    and C.Trick ~= "OFF" then
    C.Trick = "SMART"
end

function F.connect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(S.connections, connection)
    return connection
end

function F.flat(v)
    return Vector3.new(v.X, 0, v.Z)
end

function F.unit(v)
    return v.Magnitude > 0.001 and v.Unit or Vector3.zero
end

function F.limit(v, maximum)
    return v.Magnitude > maximum and v.Unit * maximum or v
end

function F.stop(force)
    local was = S.driving
    S.driving, S.drive = false, Vector3.zero

    if was and S.humanoid and S.humanoid.Parent
        and (force or not F.manualMove()) then
        pcall(function()
            S.humanoid:Move(Vector3.zero, false)
        end)
    end
end

function F.reset()
    S.phase = "IDLE"
    S.phaseBall, S.finish, S.ball, S.lane = nil, nil, nil, nil
    S.nextPlan = 0
    F.stop()
end

function F.pause(reason)
    F.stop(true)

    C.Dribble, C.Moss, C.Juggle, C.Mode =
        false, false, false, "SMART"

    F.reset()

    S.manualDown, S.manualUntil, S.touchAt = false, 0, -100
    S.inspect, S.rebind, S.probe, S.pending =
        false, false, nil, false

    S.mossMessage, S.errorUntil, S.spawnStable = nil, nil, nil
    S.spawnReady, S.spawnAt = false, os.clock() + 0.6
    S.generation += 1
    S.nextKick = 0
    S.message = reason or "New spawn: automatic modes OFF"

    for _, record in pairs(S.balls) do
        F.clearPairs(record)
    end
end

function F.save()
    local data = {}

    for _, key in ipairs(configKeys) do
        data[key] = key == "DribbleKey"
            and C.DribbleKey.Name or C[key]
    end

    env.AXION_ADVANCED_OPTIONS = data

    if type(writefile) == "function" then
        pcall(function()
            writefile(fileName, Http:JSONEncode(data))
        end)
    end
end

function F.character()
    local character = player.Character

    if character ~= S.character then
        F.pause("New spawn: waiting for character and game HUD")
        S.character = character
        S.removing = nil
        S.nextWorld = 0
    end

    S.root = character
        and character:FindFirstChild("HumanoidRootPart")

    S.humanoid = character
        and character:FindFirstChildOfClass("Humanoid")

    if S.rays then
        local ignore = {}
        if character then table.insert(ignore, character) end
        if S.folder then table.insert(ignore, S.folder) end
        S.rays.FilterDescendantsInstances = ignore
    end

    if S.humanoid ~= S.watchedHumanoid then
        if S.deathConnection then
            S.deathConnection:Disconnect()
        end

        S.watchedHumanoid = S.humanoid

        if S.humanoid then
            S.deathConnection = F.connect(
                S.humanoid.Died,
                function()
                    F.pause("Character died: automatic modes OFF")
                end
            )
        end
    end

    return character
        and character.Parent
        and character ~= S.removing
        and S.root
        and S.root.Parent == character
        and not S.root.Anchored
        and S.humanoid
        and S.humanoid.Parent == character
        and S.humanoid.Health > 0
end

function F.values()
    local gui = player:FindFirstChild("PlayerGui")
    local main = gui and gui:FindFirstChild("Main")
    return main and main:FindFirstChild("Values")
end

function F.gameReason()
    if not F.character() then
        return "waiting for a living character"
    end

    if player.Team and (
        player.Team.Name == "Spectating"
        or player.Team.Name == "Picking"
    ) then
        return "join a playing team"
    end

    local values = F.values()
    local active = values and values:FindFirstChild("Active")
    local menu = values and values:FindFirstChild("InMenu")
    local ragdoll = values and values:FindFirstChild("Ragdoll")

    if not (active and menu and ragdoll) then
        return "waiting for game HUD"
    end

    if not active.Value then return "waiting for active play" end
    if menu.Value then return "close the game menu" end
    if ragdoll.Value then return "recovering from ragdoll" end
end

function F.blocked()
    local reason = F.gameReason()

    if reason then
        S.spawnStable = nil
        if S.spawnReady then F.pause(reason) end
        return reason
    end

    if not S.spawnReady then
        local now = os.clock()
        S.spawnStable = S.spawnStable or now

        if now < S.spawnAt or now - S.spawnStable < 0.25 then
            return "waiting for spawn to settle"
        end

        S.spawnReady = true
    end

    if not S.focused then return "game window is unfocused" end
    if Input:GetFocusedTextBox() then return "typing in a text box" end
end

function F.manualMove()
    for _, key in ipairs({
        Enum.KeyCode.W, Enum.KeyCode.A,
        Enum.KeyCode.S, Enum.KeyCode.D,
        Enum.KeyCode.Up, Enum.KeyCode.Down,
        Enum.KeyCode.Left, Enum.KeyCode.Right,
    }) do
        if Input:IsKeyDown(key) then return true end
    end

    if Input.GamepadEnabled then
        for _, value in ipairs(
            Input:GetGamepadState(Enum.UserInputType.Gamepad1)
        ) do
            if value.KeyCode == Enum.KeyCode.Thumbstick1
                and value.Position.Magnitude > 0.22 then
                return true
            end
        end
    end

    return Input.TouchEnabled
        and os.clock() - S.touchAt < 0.3
end

function F.message(text)
    S.message = text
end

function F.clearPairs(record)
    for _, pair in ipairs(record.pairs or {}) do
        pair:Destroy()
    end
    record.pairs, record.character = nil, nil
end

function F.restore(ball, record)
    F.clearPairs(record)

    if ball.Parent then
        pcall(function()
            ball.Size = record.size
        end)
    end
end

function F.syncBalls()
    local folder = World:FindFirstChild("Footballs")
    S.folder = folder

    local present = {}

    if folder then
        for _, ball in ipairs(folder:GetChildren()) do
            if ball:IsA("BasePart") and ball.Name == "Ball" then
                present[ball] = true

                if not S.balls[ball] then
                    S.balls[ball] = {size = ball.Size}
                end
            end
        end
    end

    for ball, record in pairs(S.balls) do
        if not present[ball] then
            F.restore(ball, record)
            S.balls[ball] = nil
        else
            local size = C.Reach
                and Vector3.new(
                    C.ReachSize, C.ReachSize, C.ReachSize
                )
                or record.size

            if ball.Size ~= size then
                ball.Size = size
            end

            local protect = C.Reach
                and C.Shield
                and S.root
                and S.character
                and (ball.Position - S.root.Position).Magnitude < 36

            if not protect then
                F.clearPairs(record)
            elseif record.character ~= S.character then
                F.clearPairs(record)
                record.pairs, record.character = {}, S.character

                for _, part in ipairs(S.character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        local pair = Instance.new("NoCollisionConstraint")
                        pair.Name = "AXION_Shield"
                        pair.Part0 = ball
                        pair.Part1 = part
                        pair.Parent = ball
                        table.insert(record.pairs, pair)
                    end
                end
            end
        end
    end
end

function F.closest(radius)
    if not S.root then return nil, math.huge end

    local best, distance = nil, radius
    local center = S.root.Position - Vector3.new(0, 0.25, 0)

    for ball in pairs(S.balls) do
        if ball.Parent == S.folder and not ball.Anchored then
            local d = (ball.Position - center).Magnitude

            if d <= distance then
                best, distance = ball, d
            end
        end
    end

    if S.ball and S.balls[S.ball]
        and S.ball.Parent == S.folder
        and not S.ball.Anchored then

        local locked = (S.ball.Position - center).Magnitude

        if locked <= radius and locked <= distance + 0.65 then
            return S.ball, locked
        end
    end

    return best, distance
end

function F.part(node)
    if not node then return nil end
    if node:IsA("BasePart") then return node end

    return (node:IsA("Model") and node.PrimaryPart)
        or node:FindFirstChildWhichIsA("BasePart", true)
end

function F.goals(field)
    local hitboxes = field:FindFirstChild("Hitboxes")
    local goals = hitboxes and hitboxes:FindFirstChild("Goals")

    return F.part(goals and goals:FindFirstChild("Home")),
        F.part(goals and goals:FindFirstChild("Away"))
end

function F.bounds(field)
    S.bounds = nil

    local decor = field:FindFirstChild("Decor")
    local lines = decor and decor:FindFirstChild("Lines")
    local outline = lines and (
        lines:FindFirstChild("Outdoor")
        or lines:FindFirstChild("Indoor")
    )

    if not outline then return end

    local loX, hiX = math.huge, -math.huge
    local loZ, hiZ = math.huge, -math.huge

    for _, part in ipairs(outline:GetDescendants()) do
        if part:IsA("BasePart") then
            local cf = part.CFrame
            local size = part.Size * 0.5
            local pos = part.Position

            local x =
                math.abs(cf.RightVector.X) * size.X
                + math.abs(cf.UpVector.X) * size.Y
                + math.abs(cf.LookVector.X) * size.Z

            local z =
                math.abs(cf.RightVector.Z) * size.X
                + math.abs(cf.UpVector.Z) * size.Y
                + math.abs(cf.LookVector.Z) * size.Z

            loX, hiX = math.min(loX, pos.X - x),
                math.max(hiX, pos.X + x)
            loZ, hiZ = math.min(loZ, pos.Z - z),
                math.max(hiZ, pos.Z + z)
        end
    end

    if hiX - loX > 12 and hiZ - loZ > 12 then
        S.bounds = {
            loX + 2.2, hiX - 2.2,
            loZ + 2.2, hiZ - 2.2,
        }
    end
end

function F.bound(point)
    local bounds = S.bounds

    return bounds and Vector3.new(
        math.clamp(point.X, bounds[1], bounds[2]),
        point.Y,
        math.clamp(point.Z, bounds[3], bounds[4])
    ) or point
end

function F.world()
    if not S.root then return end

    local stadium = World:FindFirstChild("Stadium")
    S.fields = stadium and stadium:FindFirstChild("Fields")

    if not S.fields then
        S.field, S.goal, S.bounds = nil, nil, nil
        return
    end

    local best, score = nil, math.huge

    for _, field in ipairs(S.fields:GetChildren()) do
        local home, away = F.goals(field)

        if home or away then
            local center = home and away
                and (home.Position + away.Position) * 0.5
                or (home or away).Position

            local point = field:FindFirstChild("Point")
            if point and point:IsA("BasePart") then
                center = point.Position
            end

            local d = F.flat(
                center - S.root.Position
            ).Magnitude - (field == S.field and 7 or 0)

            if d < score then
                best, score = field, d
            end
        end
    end

    if S.selectedField and S.selectedField.Parent == S.fields then
        best = S.selectedField
    end

    if not best then
        S.field, S.goal, S.bounds = nil, nil, nil
        return
    end

    if best ~= S.field or not S.bounds then
        F.bounds(best)
    end

    S.field = best

    local home, away = F.goals(best)
    local team = player.Team and player.Team.Name

    if S.selectedGoal and S.selectedGoal.Parent
        and (
            S.selectedGoal == home
            or S.selectedGoal == away
        ) then
        S.goal = S.selectedGoal
    elseif team == "Home" then
        S.goal = away
    elseif team == "Away" then
        S.goal = home
    elseif not home or not away then
        S.goal = home or away
    else
        local homeDirection =
            F.flat(home.Position - S.root.Position)
        local awayDirection =
            F.flat(away.Position - S.root.Position)

        if math.min(
            homeDirection.Magnitude, awayDirection.Magnitude
        ) < 40 then
            S.goal = homeDirection.Magnitude < awayDirection.Magnitude
                and home or away
        else
            S.goal =
                F.unit(homeDirection):Dot(S.root.CFrame.LookVector)
                > F.unit(awayDirection):Dot(S.root.CFrame.LookVector)
                and home or away
        end
    end
end

function F.enemies(now)
    local result, history = {}, {}

    if not S.root then
        S.enemies, S.history = result, history
        return
    end

    for _, other in ipairs(Players:GetPlayers()) do
        local team = other.Team and other.Team.Name

        if other ~= player
            and not (player.Team and other.Team == player.Team)
            and team ~= "Spectating"
            and team ~= "Picking"
            and other.Character then

            local root = other.Character:
                FindFirstChild("HumanoidRootPart")
            local humanoid = other.Character:
                FindFirstChildOfClass("Humanoid")

            if root and humanoid and humanoid.Health > 0
                and (root.Position - S.root.Position).Magnitude < 60 then

                local velocity = F.limit(
                    F.flat(root.AssemblyLinearVelocity), 80
                )
                local previous = S.history[other]

                local acceleration = previous and F.limit(
                    (velocity - previous.velocity)
                        / math.max(now - previous.at, 0.03),
                    50
                ) or Vector3.zero

                local enemy = {
                    pos = root.Position,
                    velocity = velocity,
                    accel = acceleration,
                    at = now,
                }

                history[other] = enemy
                table.insert(result, enemy)
            end
        end
    end

    S.enemies, S.history = result, history
end

function F.latency()
    local ok, value = pcall(function()
        return player:GetNetworkPing()
    end)

    if not ok or type(value) ~= "number" then
        ok, value = pcall(function()
            return game:GetService("Stats")
                .Network.ServerStatsItem["Data Ping"]:GetValue()
                / 2000
        end)
    end

    if ok and type(value) == "number" and value == value then
        S.ping = S.ping * 0.75
            + math.clamp(value, 0, 0.5) * 0.25
    end
end

function F.enemyAt(enemy, time)
    return enemy.pos
        + enemy.velocity * time
        + enemy.accel * (0.5 * time * time)
end

function F.pressure(point)
    local distance, threat = math.huge, nil

    for _, enemy in ipairs(S.enemies) do
        local d = F.flat(
            F.enemyAt(
                enemy,
                math.clamp(S.ping + 0.08, 0.08, 0.35)
            ) - point
        ).Magnitude

        if d < distance then
            distance, threat = d, enemy
        end
    end

    return distance, threat
end

function F.intent(manual)
    if manual and S.humanoid.MoveDirection.Magnitude > 0.1 then
        return F.unit(F.flat(S.humanoid.MoveDirection))
    end

    if S.goal and S.goal.Parent then
        return F.unit(F.flat(
            S.goal.Position - S.root.Position
        ))
    end

    return F.unit(F.flat(S.root.CFrame.LookVector))
end

function F.plan(ball, forward, now)
    if now < S.nextPlan and S.lane
        and S.planBall == ball
        and S.planForward:Dot(forward) > 0.9 then
        return S.lane
    end

    S.nextPlan, S.planBall, S.planForward =
        now + 0.06, ball, forward

    local pressure, threat = F.pressure(ball.Position)
    S.pressure, S.threat = pressure, threat

    if not C.Avoid or (#S.enemies == 0 and not S.rays) then
        S.lane, S.move = forward, "CARRY"
        return forward
    end

    local side = Vector3.new(-forward.Z, 0, forward.X)
    local best, bestScore, bestAngle =
        forward, -math.huge, 0

    local lead = math.clamp(S.ping + 0.06, 0.06, 0.32)

    for _, degrees in ipairs(S.angles) do
        local angle = math.rad(degrees)
        local direction =
            forward * math.cos(angle)
            + side * math.sin(angle)

        local score = direction:Dot(forward) * 2.4

        if S.lane then
            score += direction:Dot(S.lane) * 0.55
        end

        if S.rays then
            local hit = World:Raycast(
                S.root.Position, direction * 5.5, S.rays
            )

            if hit then
                score -= 15 * (
                    1 - math.clamp(hit.Distance / 5.5, 0, 1)
                )
            end
        end

        for i = 1, 3 do
            local time = lead + i * 0.10
            local point =
                ball.Position + direction * (1.0 + i * 1.1)

            score -= F.flat(
                point - F.bound(point)
            ).Magnitude * 3.5

            for _, enemy in ipairs(S.enemies) do
                local d = F.flat(
                    F.enemyAt(enemy, time) - point
                ).Magnitude

                score -= math.max(0, 6 - d)^2 * 0.14
            end
        end

        if score > bestScore then
            best, bestScore, bestAngle =
                direction, score, degrees
        end
    end

    S.lane = F.unit(best)
    S.move = math.abs(bestAngle) >= 110
        and "DRAG BACK"
        or (pressure < 8 and "SHIELD / CUT" or "CARRY")

    S.threat = threat
    return S.lane
end

function F.intercept(ball)
    local origin = ball.Position
    local velocity = F.flat(ball.AssemblyLinearVelocity)
    local speed = math.max(S.humanoid.WalkSpeed or 16, 8)
    local target = origin

    for i = 1, 8 do
        local time = i * 0.10
        target = F.bound(
            origin
                + velocity * math.min(time + S.ping, 0.65)
        )

        if F.flat(
            target - S.root.Position
        ).Magnitude <= speed * time + 2 then
            break
        end
    end

    return target
end

function F.remote()
    if S.remote and S.remote.Parent then return S.remote end

    local remotes = Storage:FindFirstChild("Remotes")
    local gameRemotes = remotes and remotes:FindFirstChild("Game")
    local touch = gameRemotes and gameRemotes:FindFirstChild("Touch")
    local kick = touch and touch:FindFirstChild("Kick")

    S.remote = nil

    if kick and (
        kick:IsA("RemoteEvent") or kick:IsA("RemoteFunction")
    ) then
        S.remote = kick
    elseif touch and touch:IsA("RemoteFunction") then
        S.remote = touch
    end

    return S.remote
end

function F.send(ball, action, power, target, lift)
    local now = os.clock()

    if now < S.nextKick then
        return false, "waiting for next touch"
    end

    if S.manualDown or now < S.manualUntil then
        return false, "manual charge has priority"
    end

    if S.pending then
        return false, "waiting for previous request"
    end

    if not (
        ball and ball.Parent == S.folder
        and not ball.Anchored
        and S.root and target
    ) then
        return false, "ball unavailable"
    end

    local remote = F.remote()

    if not remote then
        S.nextKick = now + 0.35
        return false, "Touch.Kick remote unavailable"
    end

    local flat = F.flat(target - S.root.Position)

    if flat.Magnitude < 0.05 then
        return false, "no valid aim"
    end

    local rise = lift and math.clamp(
        target.Y - S.root.Position.Y,
        -flat.Magnitude * 0.06,
        math.min(7.5, flat.Magnitude * 0.38)
    ) or 0

    local aim = CFrame.lookAt(
        S.root.Position,
        S.root.Position + flat + Vector3.new(0, rise, 0)
    )

    local payload = {
        ball,
        action,
        math.clamp(power, 0, 1),
        {Ground = not lift, Right = false, Left = false},
        aim,
        S.root.CFrame:VectorToObjectSpace(
            S.humanoid.MoveDirection
        ),
    }

    local ok = true
    local generation, ticket = S.generation, {}

    if remote:IsA("RemoteEvent") then
        ok = pcall(function()
            remote:FireServer(payload)
        end)
    else
        S.pending = ticket

        task.spawn(function()
            local success = pcall(function()
                remote:InvokeServer(payload)
            end)

            if not S.alive
                or S.generation ~= generation
                or S.pending ~= ticket then
                return
            end

            S.pending = false

            if not success then
                S.errorUntil = os.clock() + 2
                S.errorMessage = "RemoteFunction request failed"
                S.nextKick = math.max(
                    S.nextKick, os.clock() + 0.35
                )
            end
        end)
    end

    if not ok then
        S.nextKick = now + 0.25
        return false, "touch request failed"
    end

    local gap = C.Mode == "QUICK" and 0.12
        or (C.Mode == "PRECISE" and 0.30 or 0.15)

    if action == "Shoot" then gap = 0.12 end

    S.nextKick = now
        + gap
        + math.min(S.ping * 0.25, 0.08)
        + math.min(S.stalls * 0.04, 0.20)

    S.lastKick, S.requests = now, S.requests + 1

    if not S.probe then
        S.probe = {
            ball = ball,
            at = now,
            velocity = ball.AssemblyLinearVelocity,
        }
    end

    return true, "requested"
end

function F.observe(now)
    local probe = S.probe
    if not probe then return end

    if not probe.ball.Parent then
        S.probe = nil
        return
    end

    if (
        probe.ball.AssemblyLinearVelocity - probe.velocity
    ).Magnitude > 2 then
        S.stalls, S.probe = 0, nil
    elseif now - probe.at > 0.45 + S.ping * 2 then
        S.stalls, S.probe = math.min(S.stalls + 1, 5), nil
    end
end

function F.shotTarget(ball)
    if not (S.goal and S.goal.Parent) then return nil end

    local forward = F.unit(F.flat(
        S.goal.Position - S.root.Position
    ))

    if forward.Magnitude < 0.01 then return nil end

    local side = Vector3.new(-forward.Z, 0, forward.X)

    local width =
        math.abs(side:Dot(S.goal.CFrame.RightVector))
            * S.goal.Size.X * 0.5
        + math.abs(side:Dot(S.goal.CFrame.LookVector))
            * S.goal.Size.Z * 0.5

    local offset = math.clamp(width * 0.55, 0.3, 3.8)
    local best, bestScore = nil, -math.huge

    for _, sign in ipairs({-1, 0, 1}) do
        local point = S.goal.Position + side * offset * sign
        local score = -math.abs(sign) * 0.1

        for _, enemy in ipairs(S.enemies) do
            score += math.min(
                F.flat(
                    F.enemyAt(enemy, S.ping + 0.15) - point
                ).Magnitude,
                20
            )
        end

        if score > bestScore then
            best, bestScore = point, score
        end
    end

    best += forward * 2

    local height = C.MossHeight

    if C.Style == "SMART" then
        height = F.pressure(
            ball and ball.Position or S.root.Position
        ) < 6 and 1 or 0
    end

    return Vector3.new(
        best.X, S.root.Position.Y + height, best.Z
    )
end

function F.moss(now)
    if not C.Moss then return false end

    local reason = F.blocked()

    if reason then
        F.message("Moss ON: " .. reason)
        return false
    end

    if not (S.goal and S.goal.Parent) then
        F.message("Moss ON: no goal • 9 select / 8 clear")
        return false
    end

    local distance = F.flat(
        S.goal.Position - S.root.Position
    ).Magnitude

    if distance > C.NetRange then
        F.message(string.format(
            "Moss ON: goal %.0f studs away • get within %.0f",
            distance, C.NetRange
        ))
        return false
    end

    local ball = F.closest(C.MossRange)

    if not ball then
        F.message(string.format(
            "Moss ON: waiting for ball within %.1f studs",
            C.MossRange
        ))
        return false
    end

    F.stop()
    S.finish, S.phase, S.phaseBall = nil, "IDLE", nil

    local toward = F.unit(F.flat(
        S.goal.Position - ball.Position
    ))

    if (
        S.shotBall == ball
        and now - (S.shotAt or -100) < 0.45
    ) or F.flat(
        ball.AssemblyLinearVelocity
    ):Dot(toward) > 22 then
        F.message("Moss: ball already traveling toward goal")
        return true
    end

    local target = F.shotTarget(ball)

    local ok, message = F.send(
        ball, "Shoot", 1, target,
        target and target.Y - S.root.Position.Y > 0.05
    )

    if ok then S.shotBall, S.shotAt = ball, now end

    F.message(
        ok and "Moss: 100% shot requested"
        or ("Moss ON: " .. message)
    )

    return true
end

function F.combo(ball, direction, now, reach)
    if S.phaseBall and S.phaseBall ~= ball then
        S.phase, S.phaseBall = "IDLE", nil
    end

    local height = ball.Position.Y - S.root.Position.Y
    local vy = ball.AssemblyLinearVelocity.Y

    if S.phase == "LIFT" then
        if ball.Position.Y > S.startY + 0.45 then
            S.rose = true
        end

        if now - S.phaseAt > 1.2 + S.ping then
            S.phase, S.phaseBall, S.lastTrick =
                "IDLE", nil, now
            return false
        end

        if S.rose and vy <= 1
            and now - S.phaseAt > 0.16
            and height < 3.6 then

            local target = F.bound(
                ball.Position + direction * 2.4
            )

            if F.send(
                ball, "Dribble", 0.10, target, false
            ) then
                S.phase, S.phaseAt, S.lastTrick =
                    "RECOVER", now, now
            end
        end

        return true
    elseif S.phase == "RECOVER" then
        if now - S.phaseAt < 0.22 + S.ping then
            return true
        end

        S.phase, S.phaseBall = "IDLE", nil
    end

    local wantsPop = C.Juggle
        or C.Trick == "ALWAYS"
        or (C.Trick == "SMART" and S.pressure < 4.0)

    if wantsPop
        and now - S.lastTrick > 0.8 + S.ping
        and math.abs(vy) < 8
        and height < 1.2 then

        local lift = C.Juggle and 3.4 or 2.0
        local target = F.bound(
            ball.Position + direction * 2.4
        ) + Vector3.new(0, lift + 2.2, 0)

        if F.send(
            ball, "Dribble",
            C.Juggle and 0.21 or 0.18,
            target, true
        ) then
            S.phase = "LIFT"
            S.phaseBall = ball
            S.phaseAt = now
            S.startY = ball.Position.Y
            S.rose = false
            S.lastTrick = now

            F.message(
                C.Juggle and "Juggle: lift and recover"
                or "Evasion: pop and recover"
            )
            return true
        end
    end

    if C.Air and height > 0.5
        and height < 3.6 and vy < -1 then

        if F.send(
            ball, "Dribble", 0.10,
            F.bound(ball.Position + direction * 2),
            false
        ) then
            F.message("Air control: descending-ball touch")
            return true
        end
    end

    return false
end

function F.finish(now)
    local finish = S.finish
    if not finish then return false end

    if not finish.ball.Parent
        or finish.ball.Parent ~= S.folder
        or now - finish.at > 1.7 + S.ping then
        S.finish = nil
        return false
    end

    local ball = finish.ball
    local distance = (
        ball.Position - S.root.Position
    ).Magnitude

    if distance > (C.Reach and C.ReachSize or 3.5) then
        F.message("Finish: waiting for ball to return")
        return true
    end

    if finish.phase == "START" then
        local direction = F.intent(false)
        local target =
            ball.Position
            + direction * 2.5
            + Vector3.new(0, 5.2, 0)

        if F.send(
            ball, "Dribble", 0.20, target, true
        ) then
            finish.phase = "LIFT"
            finish.startY = ball.Position.Y
            finish.liftAt = now
        end
    else
        if ball.Position.Y > finish.startY + 0.45 then
            finish.rose = true
        end

        if finish.rose
            and ball.AssemblyLinearVelocity.Y <= 1
            and now - finish.liftAt > 0.18 then

            local target = F.shotTarget(ball)

            if F.send(
                ball, "Shoot", 1, target,
                target and target.Y - S.root.Position.Y > 0.05
            ) then
                S.finish = nil
                F.message("Finish: shot requested")
            end
        end
    end

    return true
end

function F.control(now, dt)
    if not C.Dribble and not S.finish
        and C.Mode == "SMART" then
        F.stop()
        return
    end

    local reason = F.blocked()

    if reason then
        F.stop()
        F.message(reason)
        return
    end

    if S.manualDown or now < S.manualUntil then
        F.stop()
        F.message("manual charge has priority")
        return
    end

    if F.finish(now) then
        F.stop()
        return
    end

    local ball, distance = F.closest(C.Chase)

    if not ball then
        S.ball = nil
        F.stop()
        F.message(
            S.folder and "Dribble: waiting for ball"
            or "waiting for workspace.Footballs"
        )
        return
    end

    S.ball = ball

    local manual = F.manualMove()
    local forward = F.intent(manual)

    if distance > (C.Reach and C.ReachSize or 3.5)
        and not manual then
        forward = F.unit(F.flat(
            F.intercept(ball) - S.root.Position
        ))
    end

    local direction = F.plan(ball, forward, now)
    local reach = C.Reach and C.ReachSize or 3.5

    local target = distance > reach
        and F.bound(S.root.Position + direction * 5)
        or F.bound(ball.Position + direction * 1.6)

    local chase = F.unit(F.flat(
        target - S.root.Position
    ))

    if C.Dribble and C.Walk and not manual
        and chase.Magnitude > 0.01 then

        local alpha = 1 - math.exp(-12 * dt)

        S.drive = F.unit(
            S.drive * (1 - alpha) + chase * alpha
        )
        S.driving = true
    else
        F.stop()
    end

    if distance > reach then
        F.message("Dribble: intercepting moving ball")
        return
    end

    if not C.Dribble then
        if F.send(
            ball, "Dribble", 0.12,
            F.bound(ball.Position + direction * 2.8),
            false
        ) then
            F.message(C.Mode .. " touch assist")
        end
        return
    end

    if F.combo(ball, direction, now, reach) then return end

    local velocity = F.flat(ball.AssemblyLinearVelocity)
    local relative =
        velocity - F.flat(S.root.AssemblyLinearVelocity)

    local escaping = relative:Dot(direction) > 7
        or relative:Dot(direction) < -4

    local need = distance < 2.8
        or velocity.Magnitude < 6
        or S.pressure < 9
        or escaping
        or velocity:Dot(direction) < 0

    if not need then
        F.message("Dribble: matching ball pace")
        return
    end

    local stride = S.pressure < 7 and 2.2 or 3.6
    local power = math.clamp(
        0.11
            + (stride - 2.2) * 0.025
            + math.min(S.ping, 0.2) * 0.07,
        0.09,
        0.18
    )

    local touchTarget = F.bound(
        ball.Position + direction * stride
    )

    if C.Avoid and S.pressure < 6 and S.threat then
        local away = F.unit(F.flat(
            S.root.Position
                - F.enemyAt(
                    S.threat,
                    math.min(S.ping + 0.08, 0.35)
                )
        ))

        local shield =
            S.root.Position
            + direction * 0.8
            + away * 2.1

        touchTarget = F.bound(Vector3.new(
            shield.X, ball.Position.Y, shield.Z
        ))
        power = math.min(power, 0.12)
    end

    if F.send(
        ball, "Dribble", power, touchTarget, false
    ) then
        F.message("Dribble: " .. S.move)
    end
end

