function F.new(class, props, parent)
    local item = Instance.new(class)
    for key, value in pairs(props) do
        item[key] = value
    end
    item.Parent = parent
    return item
end

function F.uiConnect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(S.uiConnections, connection)
    return connection
end

function F.toggleMoss()
    local wanted = not C.Moss
    F.character()
    F.blocked()

    C.Moss = wanted
    S.mossMessage = nil
    S.nextWorld, S.nextBalls, S.nextEnemies = 0, 0, 0

    if C.Moss then F.reset() end

    F.message(
        C.Moss and "Moss ON: waiting for ball and net"
        or "Moss OFF"
    )
    F.hud()
end

function F.toggleDribble()
    local wanted = not C.Dribble
    F.character()
    F.blocked()

    C.Dribble = wanted
    F.reset()

    F.message(C.Dribble and "Dribble ON" or "Dribble OFF")
    F.hud()
end

function F.startFinish()
    if S.finish then
        S.finish = nil
        F.message("Finish cancelled")
        return
    end

    local reason = F.blocked()

    if reason then
        F.message(reason)
        return
    end

    F.world()

    local ball = F.closest(
        C.Reach and C.ReachSize or 3.5
    )

    if not ball or not S.goal
        or F.flat(
            S.goal.Position - S.root.Position
        ).Magnitude > 65 then

        F.message(
            "Finish: bring ball within reach near the opponent net"
        )
        return
    end

    C.Moss = false
    S.mossMessage = nil
    F.stop()

    S.finish = {
        ball = ball,
        at = os.clock(),
        phase = "START",
    }
end

function F.change(key, amount, low, high)
    C[key] = math.clamp(
        math.floor((C[key] + amount) * 10 + 0.5) / 10,
        low,
        high
    )

    S.nextBalls = 0
    F.save()
    F.hud()
end

function F.toggleUi()
    if S.panel then
        S.closed = not S.closed
        S.panel.Visible = not S.closed
        S.open.Visible = S.closed
    end
end

function F.armInspector()
    S.inspect = not S.inspect

    if S.inspect then
        S.advanced = true
        F.showAdvanced()
    end

    F.message(
        S.inspect
            and "9: click any world part to inspect/select its field"
            or "Selection cancelled"
