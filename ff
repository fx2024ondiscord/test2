function F.cleanup()
    if not S.alive then return end

    F.stop(true)
    S.alive, C.Moss, C.Dribble = false, false, false
    S.generation += 1

    pcall(function()
        Run:UnbindFromRenderStep(renderName)
    end)

    for _, connection in ipairs(S.connections) do
        connection:Disconnect()
    end

    for ball, record in pairs(S.balls) do
        F.restore(ball, record)
    end

    for _, connection in ipairs(S.uiConnections) do
        connection:Disconnect()
    end

    if S.ui then S.ui:Destroy() end

    S.sphere:Destroy()
    S.preview:Destroy()
    S.outline:Destroy()

    for _, part in ipairs(S.ring) do
        part:Destroy()
    end

    F.save()

    if env.AXION_SMART_TOUCH_CLEANUP == F.cleanup then
        env.AXION_SMART_TOUCH_CLEANUP = nil
    end
end

