function F.updateRing()
    local visible = C.Ring
        and S.root
        and S.humanoid
        and S.humanoid.Health > 0

    if not visible then
        for _, part in ipairs(S.ring) do
            part.Transparency = 1
        end
        return
    end

    local origin = S.root.Position - Vector3.new(
        0,
        S.humanoid.HipHeight + S.root.Size.Y * 0.5 - 0.1,
        0
    )

    for i, part in ipairs(S.ring) do
        local angle = (i - 0.5) * math.pi * 2 / #S.ring

        local position = origin + Vector3.new(
            math.cos(angle) * C.MossRange,
            0,
            math.sin(angle) * C.MossRange
        )

        part.Size = Vector3.new(
            0.08,
            0.06,
            2 * C.MossRange * math.sin(math.pi / #S.ring) + 0.03
        )

        part.CFrame = CFrame.lookAt(
            position,
            position + Vector3.new(
                -math.sin(angle), 0, math.cos(angle)
            )
        )

        part.Color = S.sphere.Color3
        part.Transparency = C.Moss and 0.25 or 0.65
    end
end

F.connect(Input.InputBegan, function(input, processed)
    if not S.alive or Input:GetFocusedTextBox() then return end

    local key = input.KeyCode

    if input.UserInputType == Enum.UserInputType.Keyboard
        and key == Enum.KeyCode.H then
        F.toggleMoss()
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseButton1
        and S.inspect then

        if processed then return end

        S.inspect = false
        local part = player:GetMouse().Target
        S.inspectedPart = part

        if part and S.fields then
            for _, field in ipairs(S.fields:GetChildren()) do
                if part:IsDescendantOf(field) then
                    S.selectedField = field
                    S.selectedGoal = nil

                    local home, away = F.goals(field)

                    for _, role in ipairs({"Home", "Away"}) do
                        local goal = role == "Home" and home or away

                        if goal and (
                            part == goal
                            or (
                                goal.Parent
                                and part:IsDescendantOf(goal.Parent)
                                and goal.Parent.Name ~= "Goals"
                            )
                        ) then
                            S.selectedGoal = goal
                            break
                        end
                    end

                    S.nextWorld = 0
                    F.message("Field selected: " .. field.Name)
                    return
                end
            end
        end

        F.message("No field selected; automatic selection remains active")
        return
    end

    if processed then return end

    if S.rebind
        and input.UserInputType == Enum.UserInputType.Keyboard then

        S.rebind = false

        local reserved = {
            H = true, K = true, B = true, U = true, N = true,
            Five = true, KeypadFive = true,
            Nine = true, Eight = true,
            KeypadNine = true, KeypadEight = true,
            Minus = true, Equals = true,
            KeypadMinus = true, KeypadPlus = true,
            Unknown = true, Escape = true,
            W = true, A = true, S = true, D = true,
            Up = true, Down = true, Left = true, Right = true,
            Space = true,
        }

        if not reserved[key.Name] then
            C.DribbleKey = key
            F.save()
            F.message("Dribble key: " .. key.Name)
        else
            F.message("Key is reserved; dribble key unchanged")
        end

        F.hud()
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or key == Enum.KeyCode.ButtonR2 then
        S.manualDown = true
        F.stop()
        return
    end

    if key == C.DribbleKey then
        F.toggleDribble()
    elseif key == Enum.KeyCode.K then
        F.toggleUi()
    elseif key == Enum.KeyCode.B then
        C.Mode = C.Mode == "QUICK" and "SMART" or "QUICK"
    elseif key == Enum.KeyCode.U then
        C.Mode = C.Mode == "PRECISE" and "SMART" or "PRECISE"
    elseif key == Enum.KeyCode.N then
        F.startFinish()
    elseif key == Enum.KeyCode.Five
        or key == Enum.KeyCode.KeypadFive then
        C.Juggle = not C.Juggle
        if C.Juggle then C.Dribble = true end
    elseif key == Enum.KeyCode.Nine
        or key == Enum.KeyCode.KeypadNine then
        F.armInspector()
    elseif key == Enum.KeyCode.Eight
        or key == Enum.KeyCode.KeypadEight then
        F.clearInspection()
    elseif key == Enum.KeyCode.Minus
        or key == Enum.KeyCode.KeypadMinus then
        F.change("ReachSize", -0.2, 1, 10)
    elseif key == Enum.KeyCode.Equals
        or key == Enum.KeyCode.KeypadPlus then
        F.change("ReachSize", 0.2, 1, 10)
    end
end)

