    local function slider(name, title, y, minimum, maximum, step)
        local caption = label(title, y, 18)

        local track = F.new("Frame", {
            Name = name .. "Track",
            Position = UDim2.fromOffset(13, y + 26),
            Size = UDim2.fromOffset(265, 5),
            BackgroundColor3 = COLORS.Off,
            BorderSizePixel = 0,
            Active = true,
        }, body)

        local fill = F.new("Frame", {
            Size = UDim2.fromScale(0, 1),
            BackgroundColor3 = Color3.fromRGB(255, 176, 78),
            BorderSizePixel = 0,
        }, track)

        local knob = F.new("TextButton", {
            Size = UDim2.fromOffset(15, 15),
            Text = "",
            BorderSizePixel = 0,
            BackgroundColor3 = COLORS.Text,
            AutoButtonColor = false,
        }, track)

        F.new("UICorner", {
            CornerRadius = UDim.new(1, 0),
        }, track)

        F.new("UICorner", {
            CornerRadius = UDim.new(1, 0),
        }, knob)

        local active

        local function render()
            local ratio = math.clamp(
                (C[name] - minimum) / (maximum - minimum),
                0, 1
            )

            caption.Text = string.format(
                "%s  %.1f", title, C[name]
            )

            fill.Size = UDim2.fromScale(ratio, 1)
            knob.Position = UDim2.new(ratio, -7, 0.5, -7)
        end

        local function apply(position)
            local ratio = math.clamp(
                (position.X - track.AbsolutePosition.X)
                    / math.max(track.AbsoluteSize.X, 1),
                0, 1
            )

            C[name] = math.clamp(
                math.floor(
                    (minimum + ratio * (maximum - minimum))
                        / step + 0.5
                ) * step,
                minimum,
                maximum
            )

            if name == "MossHeight" then
                C.Style = "CUSTOM"
            end

            render()
            F.save()
        end

        local function begin(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                active = input
                apply(input.Position)
            end
        end

        connect(track.InputBegan, begin)
        connect(knob.InputBegan, begin)

        connect(Input.InputChanged, function(input)
            if active and (
                input == active
                or input.UserInputType == Enum.UserInputType.MouseMovement
            ) then
                apply(input.Position)
            end
        end)

        connect(Input.InputEnded, function(input)
            if active and (
                input == active
                or input.UserInputType == active.UserInputType
            ) then
                active = nil
            end
        end)

        connect(Input.WindowFocusReleased, function()
            active = nil
        end)

        S.labels[name] = render
        render()
    end

