            dragging = input
            start = input.Position
            origin = frame.AbsolutePosition
        end
    end)

    connect(Input.InputEnded, function(input)
        if dragging and (
            input == dragging
            or input.UserInputType == dragging.UserInputType
        ) then
            dragging = nil
        end
    end)

    connect(Input.WindowFocusReleased, function()
        dragging = nil
    end)

    connect(Input.InputChanged, function(input)
        if not dragging
            or (
                input ~= dragging
                and input.UserInputType
                    ~= Enum.UserInputType.MouseMovement
            ) then
            return
        end

        local delta = input.Position - start
        local camera = World.CurrentCamera
        local view = camera and camera.ViewportSize
            or Vector2.new(900, 700)

        frame.Position = UDim2.fromOffset(
            math.clamp(
                origin.X + delta.X,
                0,
                math.max(0, view.X - 294)
            ),
            math.clamp(
                origin.Y + delta.Y,
                0,
                math.max(0, view.Y - frame.AbsoluteSize.Y)
            )
        )

        S.windowPosition = frame.Position
    end)

    F.hud()
end

function F.hud()
    if not S.alive or not S.ui or not S.ui.Parent then
        return
    end

    local function toggle(name, text, value)
        local button = S.buttons[name]
        if not button then return end

        button.Text = text .. (value and " ON" or " OFF")
        button.BackgroundColor3 =
            value and COLORS.On or COLORS.Off
    end

    toggle("Reach", string.format("REACH %.1f", C.ReachSize), C.Reach)
    toggle("Preview", "PREVIEW", C.Preview)
    toggle("Ring", "MOSS SPHERE", C.Ring)
    toggle("Shield", "BODY SHIELD", C.Shield)
    toggle("Moss", "MOSS [H]", C.Moss)
    toggle("Boost", "B 120 ms", C.Mode == "QUICK")
    toggle("Ultra", "U 300 ms", C.Mode == "PRECISE")
    toggle("Dribble", "DRIBBLE [" .. C.DribbleKey.Name .. "]", C.Dribble)
    toggle("Walk", "AUTO WALK", C.Walk)
    toggle("Avoid", "AVOID", C.Avoid)
    toggle("Juggle", "JUGGLE [5]", C.Juggle)
    toggle("Air", "AIR HELPER", C.Air)

    S.buttons.Style.Text = "MOSS " .. C.Style
    S.buttons.Trick.Text = "TRICK " .. C.Trick
    S.buttons.Finish.BackgroundColor3 =
        S.finish and COLORS.On or COLORS.Off

    S.buttons.Inspect.Text =
        S.inspect and "CLICK A PART..." or "9 PICK PART"

    S.buttons.Rebind.Text =
        S.rebind and "PRESS A KEY..."
        or "KEY: " .. C.DribbleKey.Name

    S.reachLabel.Text = string.format(
        "REACH %.1f (- / =)", C.ReachSize
    )

    for _, render in pairs(S.labels) do render() end

    S.fieldLabel.Text =
        "FIELD " .. (S.field and S.field.Name or "Unknown")
        .. (
            S.selectedField == S.field and S.field
            and " [PICKED]" or " [AUTO]"
        )

    S.statsLabel.Text =
        C.Mode
        .. string.format(" • %.0f ms estimate", S.ping * 2000)
        .. " • "
        .. (C.Walk and "AUTO WALK" or "MANUAL WALK")

    S.statusLabel.Text =
        (
            S.errorUntil
            and os.clock() < S.errorUntil
            and S.errorMessage
        )
        or (C.Moss and S.mossMessage)
        or S.message

    local part = S.inspectedPart

    if part and part.Parent then
        S.inspectName.Text = "NAME: " .. part.Name

        S.inspectMeta.Text =
            "CLASS: " .. part.ClassName
            .. " • FIELD: "
            .. (S.selectedField and S.selectedField.Name or "AUTO")

